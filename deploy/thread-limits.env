# 算子线程上限的环境变量层(xy 2026-10-20 取证的 #5:241 线程抢 32 核 → 评测被杀)。
# 注意:这些只对**读环境变量**的库(numpy/BLAS 系)生效——opencv 与 onnxruntime 不在
# 此列,它们的线程数由代码显式设(infrastructure/thread_limits.py),两层缺一不可。
# 环境变量层一律给 1:杂库串行即可,并行预算留给代码层按核数自适应
# (lib_threads() = 核数/4,下限 2,SENTRIX_LIB_THREADS 可覆盖)。
# systemd unit 用 EnvironmentFile 引入本文件。
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
