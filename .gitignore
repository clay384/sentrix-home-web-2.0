.DS_Store
.venv/
__pycache__/
*.pyc
apps/photobench/datasets/
apps/photobench/results/
apps/photobench/logs/
apps/photobench/config/judge_providers.json
apps/photobench/config/runtime_connection.json
apps/photobench/config/*.bak-*
apps/photobench/config/vllm_targets.json

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# 并行 coverage 的临时分片（pytest-cov 写 .coverage.<host>.pid<N>.<随机>）。
# 只忽略 .coverage 会让每一次 make ci 都在仓库里留下一个未跟踪文件，
# 而 git add -A 会把它提交进去。
.coverage.*
htmlcov/
apps/web/node_modules/
apps/web/dist/
apps/api/build/
logs/
.idea/
*.env.local
/data/
*.egg-info/
